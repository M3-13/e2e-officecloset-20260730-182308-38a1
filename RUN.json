{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]
      ],
      "start": [
        "${python}", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/api/health",
        "expect_status": [200]
      },
      "env": {
        "JWT_SECRET": {
          "generate": "hex",
          "bytes": 32
        },
        "DATABASE_URL": {
          "dev": "sqlite:///./wardrobe.db"
        },
        "CORS_ORIGIN": {
          "dev": "http://localhost:5173"
        },
        "UPLOAD_DIR": {
          "dev": "uploaded_images"
        }
      }
    },
    {
      "name": "frontend",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [
        ["npm", "install"]
      ],
      "start": [
        "npm", "run", "dev"
      ],
      "port": 5173,
      "health": {
        "path": "/"
      }
    }
  ]
}
